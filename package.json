{
  "name": "encoding-rules",
  "displayName": "Encoding Rules",
  "publisher": "ProductivityPlusPlus",
  "description": "Automatic encoding rules based on file paths",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/ProductivityPlusPlus/encoding-rules#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProductivityPlusPlus/encoding-rules.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/ProductivityPlusPlus"
  },
  "bugs": {
    "url": "https://github.com/ProductivityPlusPlus/encoding-rules/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "encoding",
    "charset",
    "utf8",
    "utf-8",
    "gbk",
    "shift-jis",
    "files",
    "legacy"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [],
    "configuration": {
      "title": "Encoding Rules",
      "properties": {
        "encodingRules.rules": {
          "type": "object",
          "description": "Encoding rules grouped by encoding",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Glob pattern"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
