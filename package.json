{
  "name": "encoding-rules",
  "displayName": "Encoding Rules",
  "publisher": "ProductivityPlusPlus",
  "description": "Fix garbled text in VS Code: set encoding rules once per folder or path pattern",
  "version": "0.2.3",
  "icon": "assets/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/ProductivityPlusPlus/encoding-rules#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProductivityPlusPlus/encoding-rules.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/ProductivityPlusPlus"
  },
  "bugs": {
    "url": "https://github.com/ProductivityPlusPlus/encoding-rules/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "keywords": [
    "encoding",
    "charset",
    "file encoding",
    "text encoding",
    "encoding rules",
    "legacy encoding",
    "windows-1250",
    "windows-1252",
    "windows-1257",
    "iso-8859-1",
    "gbk",
    "shift-jis"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "encodingRules.createFileRule",
        "title": "Encoding Rules: Create Rule for Current File"
      },
      {
        "command": "encodingRules.createFolderRule",
        "title": "Encoding Rules: Create Rule for Current Folder"
      },
      {
        "command": "encodingRules.showMatchingRule",
        "title": "Encoding Rules: Show Matching Rule"
      }
    ],
    "configuration": {
      "title": "Encoding Rules",
      "properties": {
        "encodingRules.rules": {
          "type": "object",
          "description": "Encoding rules grouped by encoding",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Glob pattern"
            }
          }
        },
        "encodingRules.maxFileSize": {
          "type": "number",
          "description": "Maximum file size (in bytes) for which encoding rules will be applied. Files larger than this size will be skipped.",
          "default": 52428800
        },
        "encodingRules.showLargeFileWarning": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning when a file matches an encoding rule but is larger than encodingRules.maxFileSize."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
